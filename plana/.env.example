# Desenvolvimento local. Copie para .env e substitua os valores de exemplo.
DATABASE_URL="postgresql://plana:plana@localhost:5432/plana?schema=public"
SHADOW_DATABASE_URL="postgresql://plana:plana@localhost:5432/plana_shadow?schema=public"
AUTH_SECRET="substitua-por-uma-chave-com-pelo-menos-32-caracteres"
# Endereço pelo qual as pessoas acessam a plataforma — o que vai impresso nos
# QR Codes e nos links curtos. Em produção tem de ser o domínio público, com
# https e sem porta. Nunca 0.0.0.0, localhost, 127.0.0.1 nem IP de rede
# interna: são endereços de escuta do processo, não de destino, e o QR
# impresso com eles não abre em nenhum celular.
PUBLIC_ORIGIN="http://localhost:3000"

# E-mail transacional para o fluxo "Esqueci a senha".
# Crie a chave e valide o domínio no Resend antes de usar em produção.
RESEND_API_KEY=""
EMAIL_REMETENTE="PlanA <nao-responda@seu-dominio.com>"

# O push é opcional. Gere as chaves com: npm run chaves:vapid
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contato@exemplo.com"

# Em desenvolvimento, os arquivos são gravados nesta pasta.
DIRETORIO_ARQUIVOS="./arquivos"
